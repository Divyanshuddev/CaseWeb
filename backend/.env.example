# Application
APP_NAME=CaseWeb
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL / Neon)
# Pooled URL for app queries; optional unpooled URL for Alembic migrations
DATABASE_URL=postgresql+psycopg2://caseweb:caseweb_secret@localhost:5432/caseweb_db
DATABASE_URL_UNPOOLED=

# JWT Authentication
SECRET_KEY=change-this-to-a-long-random-cryptographic-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated exact origins, plus optional regex for Vercel preview URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=

# Storage (local or s3)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
# Optional Cloud Storage (S3-compatible) configuration
S3_BUCKET_NAME=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
